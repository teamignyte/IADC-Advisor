# Secrets — never commit
# The real .mcp.json holds literal credentials; commit .mcp.json.example instead.
.mcp.json
!.mcp.json.example

# Credential store (git PAT, keys) — never commit
.secrets/

# OS / editor cruft
.DS_Store
Thumbs.db

# Generated planning artifacts — glossary, decision records/ADRs, and build specs
# that /gumby, /pokey, and /domain-modeling write. Project outputs, not bundle source;
# kept close at hand but never committed. The folder itself is tracked via .gitkeep.
/outputs/*
!/outputs/.gitkeep
!/outputs/README.md
