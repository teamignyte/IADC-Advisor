{
  "_comment": "TEMPLATE. Copy to .mcp.json (gitignored) and replace the placeholder values with your real ones. Use LITERAL values, not ${VAR} — the Windows Desktop app does not reliably expand ${VAR} in .mcp.json (see for_liam.md). /setup walks you through it and verifies each server connects.",
  "mcpServers": {
    "iadc": {
      "type": "http",
      "url": "https://your-graph-host.example.com:8000/mcp/",
      "headers": {
        "appian-api-key": "<your-iadc-graph-api-key>"
      }
    },
    "appian": {
      "type": "stdio",
      "command": "<path-to-uv-executable>",
      "args": ["run", "--directory", "<path-to-mcp-bundle-extracted>", "python", "-m", "lcp_mcp_server"],
      "env": {
        "LCP_URL": "https://your-tenant.appiancloud.com",
        "LCP_USERNAME": "<your.appian.username>",
        "LCP_PASSWORD": "<your-appian-password>",
        "LCP_API_PATH": "/suite/plugins/servlet/stateless/lcp-api",
        "LCP_TOOL_MODE": "readonly"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "_comment": "Optional — add a CONTEXT7_API_KEY header for higher rate limits; keyless works without headers."
      }
    }
  }
}
